@using Sportify.ViewModels;
@model ChangePassword;

@{
    ViewData["Title"] = "Şifre Değiştir";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<style>
    /* Genel stiller, Login.cshtml'deki ile aynıdır */
    :root {
        --primary-green: #10b981;
        --dark-navy: #1f2937;
        --bg-gray: #f3f4f6;
    }

    .account-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: var(--bg-gray);
        padding: 20px;
    }

    .account-box {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        width: 100%;
        max-width: 420px;
        border-top: 5px solid #ef4444; /* Kırmızımsı vurgu */
    }

        .account-box h2 {
            font-weight: 800;
            color: var(--dark-navy);
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }

    .form-label {
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 0.3rem;
        font-size: 0.9rem;
    }

    .form-control {
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 12px 15px;
        transition: all 0.3s;
        width: 100%;
        box-shadow: none;
    }

        .form-control:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
            outline: none;
        }

        .form-control[readonly] {
            background-color: #f9fafb;
            color: #6b7280;
        }

    .btn-submit {
        background-color: #ef4444;
        color: white;
        padding: 15px 0;
        border-radius: 12px;
        font-weight: 700;
        border: none;
        font-size: 1rem;
        cursor: pointer;
        transition: background-color 0.2s;
        margin-top: 1rem;
    }

        .btn-submit:hover {
            background-color: #dc2626;
        }

    .back-link {
        font-weight: 500;
        color: #6b7280 !important;
    }
</style>

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4"><i class="fas fa-key" style="color: #ef4444; margin-right: 10px;"></i> Şifre Değiştirme</h2>
        <p class="text-center text-muted mb-4" style="font-size:0.9rem;">Yeni şifreni belirleyerek hesabına güvenle giriş yapabilirsin.</p>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-posta Adresi (Değiştirilemez)</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">Yeni Şifre</label>
                <input asp-for="NewPassword" class="form-control" placeholder="Yeni şifrenizi girin" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label">Yeni Şifre Tekrar</label>
                <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Yeni şifrenizi tekrar girin" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>

            <input type="submit" value="Şifreyi Güncelle" class="btn btn-submit w-100 p-2" />

            <div class="text-center mt-3">
                <a asp-controller="Account" asp-action="VerifyEmail" class="text-decoration-none mt-3 back-link">Geri Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}