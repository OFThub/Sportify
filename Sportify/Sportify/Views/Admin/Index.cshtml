@{
    ViewData["Title"] = "Yönetici Paneli";
}

<style>
    :root {
        --primary-green: #10b981;
        --dark-green: #047857;
        --dark-navy: #1f2937;
        --card-bg: #ffffff;
        --bg-gray: #f9fafb;
    }

    body {
        background-color: var(--bg-gray);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* Karşılama Banner'ı */
    .welcome-banner {
        background: linear-gradient(135deg, #10b981 0%, #065f46 100%);
        color: white;
        padding: 3rem 2rem;
        border-radius: 24px;
        margin-bottom: 3rem;
        box-shadow: 0 20px 25px -5px rgba(16, 185, 129, 0.15), 0 10px 10px -5px rgba(16, 185, 129, 0.1);
        position: relative;
        overflow: hidden;
    }

        .welcome-banner::after {
            content: "";
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            pointer-events: none;
        }

        .welcome-banner h1 {
            font-weight: 800;
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }

        .welcome-banner p {
            font-size: 1.1rem;
            opacity: 0.9;
            font-weight: 400;
            max-width: 600px;
        }

    /* Kart Yapısı */
    .dashboard-card {
        background: var(--card-bg);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 20px;
        padding: 2rem;
        height: 100%;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

        .dashboard-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border-color: rgba(16, 185, 129, 0.3);
        }

    /* İkon Kutuları */
    .icon-box {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        margin-bottom: 1.5rem;
        transition: transform 0.3s;
    }

    .dashboard-card:hover .icon-box {
        transform: scale(1.1) rotate(5deg);
    }

    .card-title {
        font-weight: 700;
        font-size: 1.25rem;
        color: var(--dark-navy);
        margin-bottom: 0.75rem;
    }

    .card-text {
        color: #6b7280;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 2rem;
        flex-grow: 1;
    }

    /* Buton */
    .btn-action {
        width: 100%;
        padding: 12px;
        border-radius: 12px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s;
        border: 2px solid transparent;
        background-color: #f3f4f6;
        color: var(--dark-navy);
    }

        .btn-action:hover {
            background-color: var(--primary-green);
            color: white;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
        }

    /* Tema Renkleri (İkon Kutuları İçin) */
    .theme-blue .icon-box {
        background-color: #eff6ff;
        color: #3b82f6;
    }

    .theme-green .icon-box {
        background-color: #ecfdf5;
        color: #10b981;
    }

    .theme-purple .icon-box {
        background-color: #f5f3ff;
        color: #8b5cf6;
    }

    .theme-orange .icon-box {
        background-color: #fffbeb;
        color: #f59e0b;
    }

</style>

<div class="container py-4">

    <div class="welcome-banner">
        <h1>Yönetici Kontrol Paneli ⚡</h1>
        <p>Sportify sistemindeki tüm operasyonları tek bir noktadan yönetin. Salonlar, eğitmenler ve randevular parmaklarınızın ucunda.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card theme-blue">
                <div>
                    <div class="icon-box">
                        <i class="fas fa-building"></i>
                    </div>
                    <h3 class="card-title">Spor Salonları</h3>
                    <p class="card-text">Sistemdeki tüm şubeleri görüntüleyin, yeni salon ekleyin veya mevcut detayları güncelleyin.</p>
                </div>
                <a asp-controller="Gym" asp-action="ListGym" class="btn-action">
                    Salonları Yönet <i class="fas fa-arrow-right ms-2" style="font-size: 0.8em;"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card theme-green">
                <div>
                    <div class="icon-box">
                        <i class="fas fa-user-ninja"></i>
                    </div>
                    <h3 class="card-title">Antrenörler</h3>
                    <p class="card-text">Eğitmen kadrosunu yönetin, uzmanlık alanlarını belirleyin ve performanslarını izleyin.</p>
                </div>
                <a asp-controller="Trainer" asp-action="ListTrainer" class="btn-action">
                    Eğitmenleri Yönet <i class="fas fa-arrow-right ms-2" style="font-size: 0.8em;"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card theme-purple">
                <div>
                    <div class="icon-box">
                        <i class="fas fa-dumbbell"></i>
                    </div>
                    <h3 class="card-title">Hizmetler</h3>
                    <p class="card-text">Ders paketlerini, üyelik tiplerini, fiyatları ve servis sürelerini yapılandırın.</p>
                </div>
                <a asp-controller="Service" asp-action="ListService" class="btn-action">
                    Servisleri Yönet <i class="fas fa-arrow-right ms-2" style="font-size: 0.8em;"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="dashboard-card theme-orange">
                <div>
                    <div class="icon-box">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h3 class="card-title">Randevular</h3>
                    <p class="card-text">Üye rezervasyonlarını takip edin, onaylayın, iptal edin veya geçmiş kayıtları inceleyin.</p>
                </div>
                <a asp-controller="Appointment" asp-action="ListAppointment" class="btn-action">
                    Takvime Git <i class="fas fa-arrow-right ms-2" style="font-size: 0.8em;"></i>
                </a>
            </div>
        </div>

    </div>
</div>