@{
    ViewData["Title"] = "Randevu Oluştur";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 bg-white rounded-5 shadow-sm">
                <div style="width: 80px; height: 80px; background: #dcfce7; color: #10b981; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 25px auto;">
                    <i class="fas fa-check fa-2x"></i>
                </div>
                <h2 class="fw-bold text-dark">Randevunuz Hazırlanıyor!</h2>
                <p class="text-muted mb-4">Seçtiğiniz hizmet için randevu kaydınız başarıyla işleniyor. Detayları profilinizden takip edebilirsiniz.</p>

                <a asp-controller="Appointment" asp-action="ListAppointment" class="btn btn-success px-5 py-3 rounded-pill fw-bold">
                    Randevularımı Gör
                </a>
            </div>
        </div>
    </div>
</div>