@using Sportify.ViewModels
@model AppointmentDetailViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-danger p-4 text-center text-white">
                    <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                    <h3 class="fw-bold">Randevu İptali</h3>
                    <p class="mb-0">Bu randevuyu silmek istediğinizden emin misiniz?</p>
                </div>

                <div class="card-body p-4">
                    <div class="list-group list-group-flush mb-4">
                        <div class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Üye Adı:</span>
                            <span class="fw-bold">@Model.UserName</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Eğitmen:</span>
                            <span class="fw-bold">@Model.TrainerName</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Hizmet:</span>
                            <span class="fw-bold">@Model.ServiceName</span>
                        </div>
                    </div>

                    <form asp-controller="Appointment" asp-action="DeleteConfirmed" method="post">
                        <input type="hidden" name="id" value="@Model.AppointmentId" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg rounded-3 fw-bold">
                                Evet, Randevuyu İptal Et
                            </button>
                            <a asp-action="ListAppointment" class="btn btn-light btn-lg rounded-3 text-muted">
                                Vazgeç, Listeye Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>