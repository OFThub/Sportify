@model Sportify.Models.Gym

@{
    ViewData["Title"] = "Salon Düzenleme";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-success p-4 text-center">
                    <h3 class="fw-bold text-white mb-0">Salonu Düzenle</h3>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="EditGym" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <input type="hidden" asp-for="GymId" />
                        <input type="hidden" asp-for="Name" />

                        <div class="form-group mb-4">
                            <label asp-for="GymName" class="form-label fw-bold text-muted small">Salon Adı</label>
                            <input asp-for="GymName" class="form-control form-control-lg bg-light border-0 rounded-3" />
                            <span asp-validation-for="GymName" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-6">
                                <div class="form-group mb-4">
                                    <label asp-for="OpenTime" class="form-label fw-bold text-muted small">Açılış</label>
                                    <input asp-for="OpenTime" type="time" class="form-control form-control-lg bg-light border-0 rounded-3" />
                                    <span asp-validation-for="OpenTime" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group mb-4">
                                    <label asp-for="CloseTime" class="form-label fw-bold text-muted small">Kapanış</label>
                                    <input asp-for="CloseTime" type="time" class="form-control form-control-lg bg-light border-0 rounded-3" />
                                    <span asp-validation-for="CloseTime" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold">
                                Değişiklikleri Kaydet
                            </button>
                            <a asp-action="ListGym" class="btn btn-link text-muted text-decoration-none small">Vazgeç</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>