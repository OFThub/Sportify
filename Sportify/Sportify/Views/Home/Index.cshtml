@{
    
    ViewData["Title"] = "Home Page";
}

<div class="hero-section text-center text-white mb-5" style="margin-top: -1.5rem;">
    <div class="container py-5">
        <h1 class="display-3 fw-bold mb-3">Build Your Dream Body</h1>
        <p class="lead mb-4 mx-auto" style="max-width: 600px;">Experience the future of fitness with AI-driven analytics, professional coaching, and state-of-the-art facilities.</p>
        <div>
            @{
                var isAuthenticated = User.Identity.IsAuthenticated;
            }

            @if (isAuthenticated)
            {
                <a asp-controller="Home" asp-action="Privacy" class="btn btn-sportify btn-lg me-3">Try AI Coach</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-sportify btn-lg me-3">Try AI Coach</a>
            }

            @if (isAuthenticated)
            {
                <a asp-controller="Appointment" asp-action="BookAppointment" class="btn btn-outline-light btn-lg rounded-pill">Book Trainer</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg rounded-pill">Book Trainer</a>
            }
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="text-center mb-5">
        <h3 class="fw-bold">World Class Services</h3>
        <div style="width: 50px; height: 3px; background-color: #00c853; margin: 10px auto;"></div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card-custom text-center h-100 p-4">
                <div class="fs-1 mb-3">💪</div>
                <h5 class="fw-bold">Premium Fitness</h5>
                <p class="text-muted small">Full access to gym equipment & cardio.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-custom text-center h-100 p-4">
                <div class="fs-1 mb-3">🧘‍♀️</div>
                <h5 class="fw-bold">Yoga Masterclass</h5>
                <p class="text-muted small">Find your inner peace with expert yogis.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-custom text-center h-100 p-4">
                <div class="fs-1 mb-3">🔥</div>
                <h5 class="fw-bold">CrossFit Intensity</h5>
                <p class="text-muted small">High intensity interval training.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-custom text-center h-100 p-4">
                <div class="fs-1 mb-3">🤸</div>
                <h5 class="fw-bold">Pilates Core</h5>
                <p class="text-muted small">Strengthen your core stability.</p>
            </div>
        </div>
    </div>
</div>

<div class="bg-dark text-white text-center py-5">
    <div class="container">
        <h3 class="mb-3">Ready to transform your life?</h3>
        <p class="mb-4">Join Sportify today and take one step closer to achieving your dreams.</p>
        @if (!isAuthenticated)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-light rounded-pill px-5 fw-bold text-success">Get Started Now</a>
        }
        
    </div>
</div>