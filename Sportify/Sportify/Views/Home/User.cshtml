@{
    ViewData["Title"] = "User Page";
}

<div class="container py-4">
    <div class="welcome-banner shadow">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="fw-bold">Welcome back, Champion! 🏆</h1>
                <p class="mb-0 fs-5 opacity-75">You are on a 12-day streak. Keep pushing your limits. Your next workout is scheduled for today.</p>
            </div>
            <div class="col-md-4 text-end d-none d-md-block">
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card-custom h-100 d-flex flex-row align-items-center">
                <div class="bg-light p-3 rounded-circle me-3 text-primary fs-3">🤖</div>
                <div>
                    <h5 class="fw-bold mb-1">AI Coach</h5>
                    <p class="text-muted small mb-0">Generate a new workout plan based on your current stats.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-custom h-100 d-flex flex-row align-items-center">
                <div class="bg-light p-3 rounded-circle me-3 text-info fs-3">📊</div>
                <div>
                    <h5 class="fw-bold mb-1">My Stats</h5>
                    <p class="text-muted small mb-0">Check your BMI, weight progress, and body composition charts.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-custom h-100 d-flex flex-row align-items-center">
                <div class="bg-light p-3 rounded-circle me-3 text-warning fs-3">💪</div>
                <div>
                    <h5 class="fw-bold mb-1">Book Trainer</h5>
                    <p class="text-muted small mb-0">Schedule a 1-on-1 session with our expert trainers.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card-custom h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold m-0">Today's Schedule</h5>
                    <span class="text-muted small">OCT 24, 2024</span>
                </div>

                <div class="d-flex align-items-center justify-content-between bg-light p-3 rounded mb-3">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-white text-dark py-2 px-3 me-3 shadow-sm">14:00</span>
                        <div>
                            <h6 class="fw-bold mb-0">Upper Body Strength</h6>
                            <small class="text-success">• with John Spartan</small>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill">View Details</button>
                </div>

                <div class="d-flex align-items-center justify-content-between bg-light p-3 rounded opacity-75">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-white text-dark py-2 px-3 me-3 shadow-sm">18:00</span>
                        <div>
                            <h6 class="fw-bold mb-0">Yoga Recovery</h6>
                            <small class="text-muted">Online Session</small>
                        </div>
                    </div>
                    <span class="badge bg-secondary rounded-pill">Completed</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-custom h-100 text-white p-4 d-flex flex-column justify-content-between" style="background-color: #1b5e20;">
                <div>
                    <h5 class="fw-bold mb-3">Daily Tip 💡</h5>
                    <p class="fst-italic opacity-75">"Consistency is key. Even a 20-minute workout is better than no workout at all. Hydrate well before you start!"</p>
                </div>
                <div class="mt-4">
                    <small class="text-uppercase opacity-50">Calories Burnt</small>
                    <div class="d-flex justify-content-between align-items-end">
                        <h2 class="fw-bold mb-0">450 <span class="fs-6 fw-normal">kcal</span></h2>
                        <div class="rounded-circle border border-2 border-success d-flex align-items-center justify-content-center" style="width:40px; height:40px;">
                            <small>75%</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>