@using Sportify.ViewModels
@model ProfileViewModel
@{
    ViewData["Title"] = "Profilim ve Yönetim Paneli";
}

<style>
    /* Modern Yatay Kaydırma Alanı */
    .scroll-container {
        display: flex;
        overflow-x: auto;
        gap: 20px;
        padding: 10px 5px 25px 5px;
        scrollbar-width: thin;
        scrollbar-color: #10b981 #f1f5f9;
    }

        .scroll-container::-webkit-scrollbar {
            height: 6px;
        }

        .scroll-container::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }

        .scroll-container::-webkit-scrollbar-thumb {
            background-color: #10b981;
            border-radius: 10px;
        }

    /* Profil Kartları */
    .profile-card {
        flex: 0 0 320px;
        background: white;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .profile-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.1);
            border-color: #10b981;
        }

    .card-accent-green {
        border-top: 5px solid #10b981;
    }

    .card-accent-blue {
        border-top: 5px solid #3b82f6;
    }

    .card-accent-purple {
        border-top: 5px solid #a855f7;
    }

    .card-body-custom {
        padding: 20px;
        flex-grow: 1;
    }

    .card-title-custom {
        font-weight: 800;
        color: #111827;
        font-size: 1.15rem;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .info-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #94a3b8;
        font-weight: 700;
        margin-top: 10px;
    }

    .info-value {
        font-weight: 600;
        color: #475569;
        margin-bottom: 8px;
    }

    .card-actions-custom {
        padding: 15px 20px;
        background: #f8fafc;
        border-bottom-left-radius: 20px;
        border-bottom-right-radius: 20px;
        display: flex;
        gap: 10px;
    }

    .btn-edit-sm {
        flex: 1;
        background: #111827;
        color: white;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 8px;
        border-radius: 8px;
        text-align: center;
        text-decoration: none;
    }

    .btn-delete-sm {
        background: #fff1f2;
        color: #e11d48;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 40px;
        margin-bottom: 20px;
    }

    .empty-state {
        background: #f8fafc;
        border: 2px dashed #e2e8f0;
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        color: #64748b;
    }
</style>

<div class="container py-4">
    <div class="mb-5">
        <h1 class="fw-bold text-dark">Profilim</h1>
        <p class="text-muted">Kayıtlı eğitmenlikleriniz, sunduğunuz hizmetler ve spor salonlarınız.</p>
    </div>

    <div class="section-header">
        <h3 class="fw-bold m-0"><i class="fas fa-user-ninja text-success me-2"></i> Eğitimlerim</h3>
        <a asp-controller="Trainer" asp-action="CreateTrainer" class="btn btn-outline-success btn-sm rounded-pill px-3">
            <i class="fas fa-plus me-1"></i> Yeni Eğitmen Kaydı
        </a>
    </div>

    @if (Model.MyTrainings != null && Model.MyTrainings.Any())
    {
        <div class="scroll-container">
            @foreach (var item in Model.MyTrainings)
            {
                <div class="profile-card card-accent-green">
                    <div class="card-body-custom">
                        <div class="card-title-custom">
                            <i class="fas fa-id-card"></i> @item.TrainerName
                        </div>
                        <div class="info-label">Çalışma Saatleri</div>
                        <div class="info-value">@item.WorkStartTime - @item.WorkEndTime</div>
                        <div class="info-label">Bağlı Salon</div>
                        <div class="info-value">@item.gym?.GymName</div>
                    </div>
                    <div class="card-actions-custom">
                        <a asp-controller="Trainer" asp-action="EditTrainer" asp-route-id="@item.TrainerId" class="btn-edit-sm">Düzenle</a>
                        <a asp-controller="Trainer" asp-action="DeleteTrainer" asp-route-id="@item.TrainerId" class="btn-delete-sm"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">Henüz eğitmen kaydınız bulunmamaktadır.</div>
    }

    <div class="section-header">
        <h3 class="fw-bold m-0"><i class="fas fa-concierge-bell text-primary me-2"></i> Sunduğum Hizmetler</h3>
        <a asp-controller="Service" asp-action="CreateService" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="fas fa-plus me-1"></i> Yeni Hizmet Ekle
        </a>
    </div>

    @if (Model.MyServices != null && Model.MyServices.Any())
    {
        <div class="scroll-container">
            @foreach (var item in Model.MyServices)
            {
                <div class="profile-card card-accent-blue">
                    <div class="card-body-custom">
                        <div class="card-title-custom text-primary">
                            <i class="fas fa-dumbbell"></i> @item.ServiceName
                        </div>
                        <div class="info-label">Fiyat</div>
                        <div class="info-value text-dark fw-bold">@item.ServicePrice TL</div>
                        <div class="info-label">Süre</div>
                        <div class="info-value">@item.ServiceTime Dakika</div>
                        <div class="info-label">Lokasyon / Eğitmen</div>
                        <div class="small text-muted">@item.gym?.GymName / @item.trainer?.TrainerName</div>
                    </div>
                    <div class="card-actions-custom">
                        <a asp-controller="Service" asp-action="EditService" asp-route-id="@item.ServiceId" class="btn-edit-sm" style="background: #3b82f6;">Düzenle</a>
                        <a asp-controller="Service" asp-action="DeleteService" asp-route-id="@item.ServiceId" class="btn-delete-sm"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">Tanımlanmış bir hizmetiniz bulunmamaktadır.</div>
    }

    <div class="section-header">
        <h3 class="fw-bold m-0"><i class="fas fa-store text-purple me-2" style="color:#a855f7;"></i> Spor Salonlarım</h3>
        <a asp-controller="Gym" asp-action="CreateGym" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="fas fa-plus me-1"></i> Yeni Salon Kaydı
        </a>
    </div>

    @if (Model.MyGyms != null && Model.MyGyms.Any())
    {
        <div class="scroll-container">
            @foreach (var item in Model.MyGyms)
            {
                <div class="profile-card card-accent-purple">
                    <div class="card-body-custom">
                        <div class="card-title-custom" style="color:#a855f7;">
                            <i class="fas fa-map-marker-alt"></i> @item.GymName
                        </div>
                        <div class="info-label">Operasyon Saatleri</div>
                        <div class="info-value">@item.OpenTime - @item.CloseTime</div>
                        <div class="info-label">Sistem Kayıt No</div>
                        <div class="info-value">#@item.GymId</div>
                    </div>
                    <div class="card-actions-custom">
                        <a asp-controller="Gym" asp-action="EditGym" asp-route-id="@item.GymId" class="btn-edit-sm" style="background: #a855f7;">Düzenle</a>
                        <a asp-controller="Gym" asp-action="DeleteGym" asp-route-id="@item.GymId" class="btn-delete-sm"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">Kayıtlı spor salonu kaydınız bulunmamaktadır.</div>
    }

    <div class="section-header">
        <h3 class="fw-bold m-0">
            <i class="fas fa-calendar-check me-2" style="color:#14b8a6;"></i>
            Randevularım
        </h3>
        <a asp-controller="Appointment"
           asp-action="BookAppointment"
           class="btn btn-outline-success btn-sm rounded-pill px-3">
            <i class="fas fa-plus me-1"></i> Yeni Randevu Oluştur
        </a>
    </div>

    @if (Model.MyAppointments != null && Model.MyAppointments.Any())
    {
        <div class="scroll-container">
            @foreach (var item in Model.MyAppointments)
            {
                <div class="profile-card card-accent-teal">
                    <div class="card-body-custom bg-teal-soft">

                        <div class="info-label text-teal">Randevu Saatleri</div>
                        <div class="info-value">
                            @item.trainer?.WorkStartTime - @item.trainer?.WorkEndTime
                        </div>

                        <div class="info-label text-teal">Randevu Yeri</div>
                        <div class="info-value">#@item.gym?.GymName</div>

                        <div class="info-label text-teal">Randevu Hizmeti</div>
                        <div class="info-value">#@item.service?.ServiceName</div>

                        <div class="info-label text-teal">Randevu Süresi</div>
                        <div class="info-value">#@item.service?.ServiceTime dk</div>

                        <div class="info-label text-teal">Randevu Ücreti</div>
                        <div class="info-value">#@item.service?.ServicePrice ₺</div>
                    </div>

                    <div class="card-actions-custom">
                        <a asp-controller="Appointment"
                           asp-action="DeleteAppointment"
                           asp-route-id="@item.AppointmentId"
                           class="btn-delete-sm" >
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state text-teal">
            Kayıtlı randevunuz bulunmamaktadır.
        </div>
    }


</div>