@model Sportify.Models.Service

@{
    ViewData["Title"] = "Servis Silme";
}

<style>
    .delete-card {
        background: white;
        border-radius: 20px;
        padding: 3rem;
        max-width: 500px;
        margin: 4rem auto;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        border-top: 8px solid #ef4444;
    }

    .warning-icon {
        font-size: 3rem;
        color: #ef4444;
        margin-bottom: 1rem;
    }

    .service-details {
        background-color: #fef2f2;
        padding: 1.5rem;
        border-radius: 12px;
        margin: 2rem 0;
        text-align: left;
    }

    .btn-confirm-delete {
        background-color: #ef4444;
        color: white;
        padding: 12px 24px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        margin-right: 10px;
    }

    .btn-cancel {
        background-color: #f3f4f6;
        color: #374151;
        padding: 12px 24px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }
</style>

<div class="delete-card">
    <div class="warning-icon">
        <i class="fas fa-exclamation-triangle"></i>
    </div>

    <h3>Emin misiniz?</h3>
    <p class="text-muted">Bu işlem geri alınamaz. Aşağıdaki servis kalıcı olarak silinecektir.</p>

    <div class="service-details">
        <h4 style="color:#991b1b; font-weight:700;">@Model.ServiceName</h4>
        <p class="mb-1"><strong>Süre:</strong> @Model.ServiceTime dk</p>
        <p class="mb-0"><strong>Ücret:</strong> @Model.ServicePrice TL</p>
    </div>

    <form asp-controller="Service" asp-action="DeleteConfirmed" asp-route-id="@Model.ServiceId">
        <input type="hidden" asp-for="ServiceId" />
        <button type="submit" class="btn btn-confirm-delete">Evet, Sil</button>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-cancel">İptal</a>
    </form>
</div>