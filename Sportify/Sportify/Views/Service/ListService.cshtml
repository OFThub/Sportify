@model List<Sportify.Models.Service>

@{
    ViewData["Title"] = "Servis Listeleme";

}

<style>
    .page-title {
        text-align: center;
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 3rem;
        margin-top: 2rem;
    }

    .service-list-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
        padding: 1rem;
    }

    .service-card {
        background: #fff;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #f0f0f0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            border-color: #10b981;
        }

        .service-card h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 1rem;
        }

    .service-meta {
        margin-bottom: 0.5rem;
        color: #6b7280;
        font-size: 0.95rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .price-tag {
        font-size: 1.5rem;
        font-weight: 800;
        color: #10b981; /* Sportify Yeşili */
        margin: 1rem 0;
    }

    .trainer-badge {
        background-color: #ecfdf5;
        color: #047857;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 1rem;
    }

    .service-actions {
        margin-top: 1.5rem;
        display: flex;
        gap: 10px;
    }

    .btn-edit {
        flex: 1;
        background-color: #f3f4f6;
        color: #374151;
        text-align: center;
        padding: 10px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-edit:hover {
            background-color: #e5e7eb;
            color: #1f2937;
        }

    .btn-delete {
        flex: 1;
        background-color: #fee2e2;
        color: #b91c1c;
        text-align: center;
        padding: 10px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-delete:hover {
            background-color: #fecaca;
        }

    .alert-custom {
        background-color: #ecfdf5;
        border: 1px solid #10b981;
        color: #065f46;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        font-weight: 600;
    }
</style>

<h1 class="page-title">World Class Services</h1>

@if (Model == null || !Model.Any())
{
    <div class="container">
        <div class="alert alert-custom">
            Henüz oluşturulmuş bir Servis bulunmamaktadır.
        </div>
    </div>
}
else
{
    <div class="container">
        <div class="service-list-container">
            @foreach (var service in Model)
            {
                <div class="service-card">
                    <div>
                        <span class="trainer-badge">
                            <i class="fas fa-user-circle"></i> @service.trainer.TrainerName
                        </span>

                        <h2>@service.ServiceName</h2>

                        <div class="service-meta">
                            <span><i class="far fa-clock"></i> Süre</span>
                            <strong>@service.ServiceTime dk</strong>
                        </div>

                        <div class="service-meta">
                            <span><i class="fas fa-map-marker-alt"></i> Lokasyon</span>
                            <strong>@service.gym.GymName</strong>
                        </div>

                        <div class="service-meta">
                            <span><i class="far fa-calendar-alt"></i> Saatler</span>
                            <span>@service.trainer.WorkStartTime - @service.trainer.WorkEndTime</span>
                        </div>

                        <div class="price-tag">
                            $@service.ServicePrice <span style="font-size:0.9rem; color:#9ca3af; font-weight:400;">/ seans</span>
                        </div>
                    </div>

                    <div class="service-actions">
                        <a asp-controller="Service"
                           asp-action="EditService"
                           asp-route-id="@service.ServiceId"
                           class="btn-edit">
                            Düzenle
                        </a>

                        <a asp-controller="Service"
                           asp-action="DeleteService"
                           asp-route-id="@service.ServiceId"
                           class="btn-delete">
                            Sil
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
}