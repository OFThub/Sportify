@model Sportify.Models.Trainer

@{
    ViewData["Title"] = "Eğitmen Sil";
}

<style>
    .delete-card {
        background: white;
        border-radius: 20px;
        padding: 3rem;
        max-width: 500px;
        margin: 4rem auto;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        border-top: 8px solid #ef4444;
    }

    .warning-icon {
        width: 80px;
        height: 80px;
        background-color: #fef2f2;
        color: #ef4444;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
    }

    .trainer-details {
        background-color: #f9fafb;
        padding: 1.5rem;
        border-radius: 12px;
        margin: 2rem 0;
        text-align: left;
        border: 1px solid #e5e7eb;
    }

    .btn-confirm-delete {
        background-color: #ef4444;
        color: white;
        padding: 12px 24px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        margin-right: 10px;
        transition: 0.2s;
    }

        .btn-confirm-delete:hover {
            background-color: #dc2626;
        }

    .btn-cancel {
        background-color: #f3f4f6;
        color: #374151;
        padding: 12px 24px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-cancel:hover {
            background-color: #e5e7eb;
            color: #1f2937;
        }
</style>

<div class="delete-card">
    <div class="warning-icon">
        <i class="fas fa-user-slash"></i>
    </div>

    <h3 style="font-weight:800; color:#1f2937;">Eğitmeni Sil?</h3>
    <p class="text-muted">Bu işlem geri alınamaz. Eğitmen ve ilgili veriler kalıcı olarak silinecektir.</p>

    <div class="trainer-details">
        <h4 style="color:#1f2937; font-weight:700; margin-bottom:1rem;">@Model.TrainerName</h4>
        <div class="d-flex justify-content-between text-secondary mb-2">
            <span><i class="far fa-clock me-2"></i>Açılış:</span>
            <strong>@Model.WorkStartTime</strong>
        </div>
        <div class="d-flex justify-content-between text-secondary">
            <span><i class="far fa-clock me-2"></i>Kapanış:</span>
            <strong>@Model.WorkEndTime</strong>
        </div>
    </div>

    <form asp-controller="Trainer" asp-action="DeleteConfirmed" asp-route-id="@Model.TrainerId" method="post">
        <input type="hidden" asp-for="TrainerId" />
        <button type="submit" class="btn btn-confirm-delete">Evet, Sil</button>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-cancel">İptal</a>
    </form>
</div>